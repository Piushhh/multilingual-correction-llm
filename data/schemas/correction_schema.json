{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorrectionDatasetSchema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the sample."
    },
    "language": {
      "type": "string",
      "description": "Language code, e.g., 'en', 'hi', 'code-mixed'."
    },
    "domain": {
      "type": "string",
      "description": "Domain of the text, e.g., 'deep_learning', 'general'."
    },
    "source_type": {
      "type": "string",
      "enum": ["human", "ocr", "synthetic"],
      "description": "Origin of the text."
    },
    "incorrect_text": {
      "type": "string",
      "description": "The text containing errors."
    },
    "correct_text": {
      "type": "string",
      "description": "The target corrected text."
    },
    "error_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of error categories present in the incorrect text."
    },
    "meaning_preserved": {
      "type": "boolean",
      "description": "Indicates whether the meaning of the original text is preserved."
    },
    "terminology_preserved": {
      "type": "boolean",
      "description": "Indicates whether technical terminology is preserved."
    },
    "verified": {
      "type": "boolean",
      "description": "Indicates whether this sample was human verified."
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test"],
      "description": "Dataset split."
    }
  },
  "required": ["id", "language", "incorrect_text", "correct_text"]
}
